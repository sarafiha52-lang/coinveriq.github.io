def P(s, st="Bodyv"):
    return Paragraph(s, ss[st])

def B(s):
    return P("• " + s, "Bulletv")

def heading(s, intro=None):
    a = [P(s, "H1v"), HRFlowable(width="100%", thickness=0.8, color=line, spaceBefore=0, spaceAfter=7)]
    if intro:
        a.insert(1, P(intro, "Bodyv"))
    return a

def note(s, bg=pale, border=blue):
    t = Table([[P(s, "Callv")]], colWidths=[170*mm])
    t.setStyle(TableStyle([
        ("BACKGROUND",(0,0),(-1,-1),bg),("BOX",(0,0),(-1,-1),0.8,border),
        ("LEFTPADDING",(0,0),(-1,-1),10),("RIGHTPADDING",(0,0),(-1,-1),10),
        ("TOPPADDING",(0,0),(-1,-1),8),("BOTTOMPADDING",(0,0),(-1,-1),8)
    ]))
    return t

def table(data, widths, repeat=1):
    t=Table(data,colWidths=widths,repeatRows=repeat)
    t.setStyle(TableStyle([
        ("BACKGROUND",(0,0),(-1,0),navy),
        ("ROWBACKGROUNDS",(0,1),(-1,-1),[colors.white,light]),
        ("GRID",(0,0),(-1,-1),0.4,line),
        ("VALIGN",(0,0),(-1,-1),"TOP"),
        ("LEFTPADDING",(0,0),(-1,-1),7),("RIGHTPADDING",(0,0),(-1,-1),7),
        ("TOPPADDING",(0,0),(-1,-1),6),("BOTTOMPADDING",(0,0),(-1,-1),6)
    ]))
    return t

